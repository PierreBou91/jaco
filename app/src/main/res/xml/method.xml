<?xml version="1.0" encoding="utf-8"?>
<!-- Jaco's keyboard. A "voice" subtype, so keyboards with a microphone key that switches to a voice
     keyboard (AOSP, HeliBoard...) can open it. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.pbou.stt.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/kb_subtype"
        android:imeSubtypeMode="voice"
        android:isAuxiliary="false"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
